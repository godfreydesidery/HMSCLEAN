# Copy to .env in the repo root and edit before running:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# .env is read automatically by docker compose; .gitignore excludes it.

# Public port on the host that the web container exposes.
HMIS_WEB_PORT=8080

# --- Postgres ---
HMIS_DB_PASSWORD=hmis

# --- API ---
# Must be at least 32 characters for HS256.
HMIS_SECURITY_JWT_SECRET=please-replace-with-a-real-32-plus-char-secret

# Comma-separated origins the API will accept CORS from. For a single-domain
# deploy where nginx proxies /api, point this at the public web origin.
HMIS_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Initial password for the bootstrap `root` account. Change it on first login.
HMIS_BOOTSTRAP_ROOT_PASSWORD=ChangeMe!123
